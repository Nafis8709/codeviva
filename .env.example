# Copy this file to .env and fill in ONE option. Never commit .env.

# --- Option A (default): Google Gemini, free tier ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3-flash-preview

# --- Option B: any OpenAI-compatible API (OpenAI, Groq, OpenRouter, local) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Demo mode: scripted examiner, no AI (also used automatically when no key is set) ---
# DEMO_MODE=1

# Port for the local server (default 3000)
# PORT=3000
